<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.football-predictor.prematch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJ_DIR__/scripts/run_prematch.sh</string>
    </array>

    <!-- Run at 15:00 local time — ~2h before typical evening kick-offs.
         Refreshes today's predictions with closing-line odds (sharper market). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>15</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/prematch-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/prematch-stderr.log</string>

    <!-- No KeepAlive. {SuccessfulExit: false} implies RunAtLoad, so it fired
         this at every login/reboot/reinstall (2026-08-31 09:19, 2026-09-07
         08:54) and restarted a failed run (2026-09-01 15:00 → 15:07). -->
</dict>
</plist>
